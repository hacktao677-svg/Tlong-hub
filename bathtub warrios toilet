-- HÀM TÌM ĐỨA YẾU MÁU NHẤT
function getWeakestTarget()
    local target = nil
    local minHealth = math.huge
    
    for _, v in pairs(game:GetService("Players"):GetPlayers()) do
        if v ~= lp and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            local teamName = v.Team and v.Team.Name or ""
            
            -- Chỉ chọn Astro hoặc Cameraman
            local isTargetTeam = false
            for _, name in pairs(TARGET_TEAMS) do
                if teamName == name then isTargetTeam = true break end
            end
            
            if isTargetTeam then
                -- So sánh máu để tìm đứa yếu nhất
                if v.Character.Humanoid.Health < minHealth then
                    minHealth = v.Character.Humanoid.Health
                    target = v
                end
            end
        end
    end
    return target
end

-- VÒNG LẶP CHÍNH
spawn(function()
    while true do
        if AutoKillEnabled then
            pcall(function()
                local target = getWeakestTarget()
                if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    -- Áp sát
                    lp.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 6)
                    
                    -- Nhìn thẳng mặt
                    lp.Character.HumanoidRootPart.CFrame = CFrame.lookAt(lp.Character.HumanoidRootPart.Position, target.Character.HumanoidRootPart.Position)
                    
                    -- Chém
                    local VU = game:GetService('VirtualUser')
                    VU:CaptureController()
                    VU:ClickButton1(Vector2.new(0, 0))
                end
            end)
        end
        task.wait(0.05) -- Quét cực nhanh để cướp kill
    end
end)

